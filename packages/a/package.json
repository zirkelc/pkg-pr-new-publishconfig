{
  "name": "a",
  "version": "1.0.1",
  "packageManager": "pnpm@9.3.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && pnpm pack | tail -n1 | xargs attw",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {}
}